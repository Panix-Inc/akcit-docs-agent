{
  "name": "@akcit/docs-agent",
  "version": "0.2.3",
  "description": "Capture, crawl, and convert documentation websites into Markdown for AI coding agents, CLI workflows, and MCP tools.",
  "type": "module",
  "bin": {
    "akcit-docs": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.pt-BR.md",
    "ARCHITECTURE.md",
    "CHANGELOG.md",
    "references",
    "LICENSE",
    ".codex-plugin",
    ".agents/skills/docs",
    ".agents/skills/prompt",
    ".agents/skills/prompt-code",
    "skills/docs",
    "skills/prompt",
    "skills/prompt-code",
    ".mcp.json",
    "gemini-extension.json",
    "commands"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dev": "tsx src/cli.ts",
    "sync-assets": "tsx scripts/sync-assets.ts",
    "prepack": "npm run sync-assets && npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run sync-assets && npm run build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "codex",
    "claude-code",
    "cursor",
    "gemini-cli",
    "mcp",
    "agent-skills",
    "ai-agents",
    "llms-txt",
    "docs-agent",
    "documentation",
    "docs",
    "crawler",
    "markdown"
  ],
  "license": "MIT",
  "author": {
    "name": "Felipe Paniago",
    "email": "felipe.paniago@hagens.com.br"
  },
  "contributors": [
    "AKCIT — Centro de Competência Embrapii em Tecnologias Imersivas"
  ],
  "homepage": "https://github.com/Panix-Inc/akcit-docs-agent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Panix-Inc/akcit-docs-agent.git"
  },
  "bugs": {
    "url": "https://github.com/Panix-Inc/akcit-docs-agent/issues"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.2",
    "cheerio": "^1.0.0",
    "commander": "^12.1.0",
    "fast-xml-parser": "^5.7.2",
    "robots-parser": "^3.0.1",
    "turndown": "^7.2.0",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/turndown": "^5.0.5",
    "@vitest/coverage-v8": "^2.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
